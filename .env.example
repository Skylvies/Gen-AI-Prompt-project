# Backend configuration. Copy this file to ".env" (same folder) and edit it.
#   Windows:  copy .env.example .env        macOS/Linux:  cp .env.example .env
# ".env" is git-ignored. NEVER commit a real key. Leave LLM_API_KEY empty to use Demo Mode only.

# --- Real mode: which LLM to call ---------------------------------------------
# groq        FREE tier, no credit card, open-source Llama models (default). Key: https://console.groq.com/keys
# openrouter  one key, many models; pick a free one (ID ends in ":free"): https://openrouter.ai/models
# ollama      models on YOUR computer: free, no key at all: https://ollama.com  (ollama pull llama3.2)
# custom      any OpenAI-compatible server: also set LLM_BASE_URL and LLM_MODEL
# anthropic   optional, Claude (paid): also run  pip install -r backend/requirements-anthropic.txt
LLM_PROVIDER=groq
LLM_API_KEY=

# Blank = the provider's default (groq: llama-3.3-70b-versatile, ollama: llama3.2).
# Model names change over time; if a model is retired, choose another from the provider's model list.
LLM_MODEL=
# Blank = the provider's standard address. Only needed for "custom" or to override.
LLM_BASE_URL=

# Same low temperature for every prompt variant = fairer comparison. Blank = do not send.
LLM_TEMPERATURE=0.3
# Output limit per answer. Raise it for "reasoning" models, which spend tokens on hidden thinking
# (use 2048 or more with LLM_PROVIDER=anthropic).
MAX_OUTPUT_TOKENS=1024

# Price per 1 million tokens in USD, to show a cost figure. Optional. Models without a known price
# (e.g. free Llama) cost $0. Set BOTH to compare a paid-equivalent cost using the provider's price list.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# --- Only for LLM_PROVIDER=anthropic -------------------------------------------
# The key is read from LLM_API_KEY, or from ANTHROPIC_API_KEY, but ONLY when LLM_PROVIDER=anthropic.
# Thinking depth: low | medium | high | xhigh | max. Blank for models without it (e.g. claude-haiku-4-5).
LLM_EFFORT=low

# --- Sharing / deployment ------------------------------------------------------
# If set, Real mode requests must send this code. STRONGLY recommended on a public site, so strangers
# cannot use up your API quota.
REAL_MODE_ACCESS_CODE=
# Comma-separated browser origins allowed to call the API (your frontend URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default is a local SQLite file at backend/data/prompt_lab.db. Any SQLAlchemy URL works.
DATABASE_URL=
# Parallel API calls per experiment. Lower it (1-2) if a free tier rate-limits you.
MAX_WORKERS=3
